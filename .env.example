# Neon connection string (pooled). Local dev: npm run db:local, then use the URL below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
IP_SALT=change-me
# Optional: ipinfo.io token (works without one at low volume)
IPINFO_TOKEN=
# Optional: Cloudflare Realtime TURN key, enables packet-loss measurement
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# International test server: test-server/server.js on an overseas VPS (Singapore recommended), e.g. https://sg.example.com
PUBLIC_INTL_URL=
