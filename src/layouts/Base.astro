---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string; // share image path
  schema?: object[]; // JSON-LD nodes, merged into one @graph
  noindex?: boolean;
  jsonAlt?: string; // machine-readable version of this page's data, for agents
  bare?: boolean; // full-bleed pages (map) skip the footer
  dither?: boolean; // animated backdrop behind the top of the page; off where a map fills that space
}
const SITE = 'WifiRank';
const {
  title,
  description = 'Real ISP speeds across Bangladesh, measured by the people who use them. Compare download and upload speed, ping and reviews for every area before you choose an internet provider.',
  ogImage = '/og-home.jpg',
  schema = [],
  noindex = false,
  jsonAlt,
  bare = false,
  dither = !bare,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : `${SITE}: Compare internet providers in Bangladesh by real speed tests`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;
const nav = [['/map', 'Map'], ['/isps', 'Rankings'], ['/methodology', 'How it works']];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${Astro.site}#site`, name: SITE, url: Astro.site?.href, inLanguage: 'en',
      description: 'Crowdsourced internet speed tests and reviews of ISPs in Bangladesh.' },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f3f3f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="LLM guide" href="/llms.txt" />
    {jsonAlt && <link rel="alternate" type="application/json" href={jsonAlt} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="geo.region" content="BD-13" />
    <meta name="geo.placename" content="Bangladesh" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    {dither && <dither-art class="page-dither" mode="signal" aria-hidden="true"></dither-art>}
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand" aria-label={`${SITE} home`}><Logo /><span>{SITE}</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
          <a class="btn btn-primary btn-sm" href="/" aria-current={path === '/' ? 'page' : undefined}>{/* shortened on phones, where the full label doesn't fit */}<span class="wide">Run a test</span><span class="narrow">Test</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!bare && (
      <footer class="site-footer">
        <dither-art class="foot-dither" mode="flow" cell="6" aria-hidden="true"></dither-art>
        <div class="wrap">
          <div class="top">
            <a href="/" class="brand" aria-label={`${SITE} home`}><Logo /><span>{SITE}</span></a>
            <nav aria-label="Footer">
              <a href="/isps">Rankings</a><a href="/map">Map</a><a href="/methodology">Methodology</a>
              <a href="/api/stats">Open data</a><a href="/llms.txt">llms.txt</a>
            </nav>
          </div>
          <div class="bottom">
            <p>Bangladesh’s internet, measured by its people.</p>
            <p>Anonymous, crowdsourced results. Not affiliated with any ISP.</p>
          </div>
        </div>
      </footer>
    )}
    <script>
      import '../scripts/dither';
      import '../scripts/fx';
    </script>
  </body>
</html>
