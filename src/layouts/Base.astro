---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
// Preloaded so text paints in the real faces instead of flashing the fallback while the CSS-discovered fonts arrive.
import groteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import dotoUrl from '@fontsource-variable/doto/files/doto-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string; // share image path
  schema?: object[]; // JSON-LD nodes, merged into one @graph
  noindex?: boolean;
  jsonAlt?: string; // machine-readable version of this page's data, for agents
  bare?: boolean; // full-bleed pages (map) skip the footer
  dither?: boolean; // animated backdrop behind the top of the page; off where a map fills that space
}
const SITE = 'WifiRank';
const {
  title,
  description = 'Real ISP speeds across Bangladesh, measured by the people who use them. Compare download and upload speed, ping and reviews for every area before you choose an internet provider.',
  ogImage = '/og-home.jpg',
  schema = [],
  noindex = false,
  jsonAlt,
  bare = false,
  dither = !bare,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : `${SITE}: Compare internet providers in Bangladesh by real speed tests`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;
const nav = [['/map', 'Map'], ['/isps', 'Rankings'], ['/methodology', 'How it works'], ['/contributors', 'Contributors']];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${Astro.site}#site`, name: SITE, url: Astro.site?.href, inLanguage: 'en',
      description: 'Crowdsourced internet speed tests and reviews of ISPs in Bangladesh.' },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    {[groteskUrl, dotoUrl, monoUrl].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f3f3f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="LLM guide" href="/llms.txt" />
    {jsonAlt && <link rel="alternate" type="application/json" href={jsonAlt} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="geo.region" content="BD-13" />
    <meta name="geo.placename" content="Bangladesh" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    {dither && <dither-art class="page-dither" mode="signal" aria-hidden="true"></dither-art>}
    <header class="site-header">
      <div class="wrap">
        <div class="brand-row">
          <a href="/" class="brand" aria-label={`${SITE} home`}><Logo /><span>{SITE}</span></a>
          <a class="credit" href="https://sou-hardo.com" rel="author">made by @sou-hardo</a>
        </div>
        <a class="gh-link" href="https://github.com/Sou-hardo/wifirank" aria-label="Source code on GitHub" rel="noopener"><svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-nav">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <nav class="nav" id="main-nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!bare && (
      <footer class="site-footer">
        <dither-art class="foot-dither" mode="flow" cell="6" aria-hidden="true"></dither-art>
        <div class="wrap">
          <div class="top">
            <a href="/" class="brand" aria-label={`${SITE} home`}><Logo /><span>{SITE}</span></a>
            <nav aria-label="Footer">
              <a href="/isps">Rankings</a><a href="/map">Map</a><a href="/methodology">Methodology</a><a href="/contributors">Contributors</a>
              <a href="/api/stats">Open data</a><a href="/llms.txt">llms.txt</a>
            </nav>
          </div>
          <div class="bottom">
            <p>Bangladesh’s internet, measured by its people.</p>
            <p>Anonymous, crowdsourced results. Not affiliated with any ISP.</p>
          </div>
        </div>
      </footer>
    )}
    <script>
      import '../scripts/dither';
      import '../scripts/fx';
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const header = document.querySelector('.site-header');
      const setOpen = (open: boolean) => { header?.classList.toggle('menu-open', open); btn?.setAttribute('aria-expanded', String(open)); };
      btn?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
      document.querySelector('#main-nav')?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
      window.addEventListener('pageshow', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      document.addEventListener('click', (e) => { if (!header?.contains(e.target as Node)) setOpen(false); });
    </script>
  </body>
</html>
