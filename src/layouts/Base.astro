---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string; // path under /og/
  schema?: object[]; // JSON-LD nodes, merged into one @graph
  noindex?: boolean;
  jsonAlt?: string; // machine-readable version of this page's data, for agents
  bare?: boolean; // full-bleed pages (map) skip the footer
}
const SITE = 'WifiRank';
const {
  title,
  description = 'Real ISP speeds across Dhaka, measured by the people who use them. Compare BDIX and international speed, ping and reviews for every area before you choose an internet provider.',
  ogImage = '/og/home.png',
  schema = [],
  noindex = false,
  jsonAlt,
  bare = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE}` : `${SITE}: Compare internet providers in Dhaka by real speed tests`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;
const nav = [['/', 'Test'], ['/map', 'Map'], ['/isps', 'Rankings'], ['/methodology', 'How it works']];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${Astro.site}#site`, name: SITE, url: Astro.site?.href, inLanguage: 'en',
      description: 'Crowdsourced internet speed tests and reviews of ISPs in Dhaka, Bangladesh.' },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b0d10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="LLM guide" href="/llms.txt" />
    {jsonAlt && <link rel="alternate" type="application/json" href={jsonAlt} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="geo.region" content="BD-13" />
    <meta name="geo.placename" content="Dhaka" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand" aria-label={`${SITE} home`}><Logo /><span>{SITE}</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!bare && (
      <footer class="site-footer">
        <div class="wrap">
          <div>
            <p style="margin:0 0 6px;color:var(--text-2)"><strong>{SITE}</strong>: Dhaka's internet, measured by its people.</p>
            <p style="margin:0">Anonymous, crowdsourced results. Not affiliated with any ISP.</p>
          </div>
          <nav aria-label="Footer">
            <a href="/isps">Rankings</a><a href="/map">Map</a><a href="/methodology">Methodology</a>
            <a href="/api/stats">Open data (JSON)</a><a href="/llms.txt">llms.txt</a>
          </nav>
        </div>
      </footer>
    )}
  </body>
</html>
