---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap" style="padding:clamp(60px,14vw,160px) 0;text-align:center">
    <div class="nosignal">
      <dither-art mode="noise" cell="6" aria-hidden="true"></dither-art>
      <p class="dot"><span>404</span></p>
    </div>
    <h1 style="font-size:1.8rem">No signal. This page dropped its connection.</h1>
    <p class="text-2">Try the <a href="/isps">rankings</a>, the <a href="/map">map</a>, or <a href="/">run a test</a>.</p>
  </section>
</Base>
