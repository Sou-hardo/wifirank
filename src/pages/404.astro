---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap" style="padding:clamp(60px,14vw,160px) 0;text-align:center">
    <p class="dot" style="font-size:clamp(5rem,18vw,11rem);line-height:1;margin:0">404</p>
    <h1 style="font-size:1.6rem;margin-top:16px">This page dropped its connection.</h1>
    <p class="text-2">Try the <a href="/isps">rankings</a>, the <a href="/map">map</a>, or <a href="/">run a test</a>.</p>
  </section>
</Base>
