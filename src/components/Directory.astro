---
import { PROVIDERS, DISTRICTS, PACKAGES, serves } from '../lib/directory';
const { district = '' } = Astro.props;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const selected = district || Astro.url.searchParams.get('district') || '';
const filtered = PROVIDERS.filter(i => (!selected || serves(i, selected)) && (!q || [i.name, ...i.aliases].some(n => n.toLowerCase().includes(q.toLowerCase()))));
const pages = Math.max(1, Math.ceil(filtered.length / 50));
const page = Math.min(pages, Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1') || 1));
const pageUrl = (p: number) => { const u = new URL(Astro.url); u.searchParams.set('page', String(p)); return u.pathname + u.search; };
---
<section class="block" style="padding-top:28px;padding-bottom:0">
  <h2>Find an internet provider</h2>
  <p class="text-2">Licence locations and published coverage. A nationwide licence does not guarantee a connection at your address; confirm with the provider.</p>
  <form class="directory-filters">
    <label class="field"><span class="label">Search providers</span><input class="input" type="search" name="q" value={q} placeholder="Name or alias" /></label>
    {!district && <label class="field"><span class="label">District</span><select class="input" name="district"><option value="">All Bangladesh</option>{DISTRICTS.map(d => <option value={d.slug} selected={d.slug === selected}>{d.name}</option>)}</select></label>}
    <button class="btn btn-primary">Search</button>
  </form>
  <p role="status">{filtered.length.toLocaleString('en')} {filtered.length === 1 ? 'provider' : 'providers'} · Page {page} of {pages}</p>
  {filtered.length ? <div class="table-wrap"><table>
    <caption class="sr-only">Internet provider directory</caption>
    <thead><tr><th scope="col">Provider</th><th scope="col">Licence category</th><th scope="col">Districts / scope</th><th scope="col">Packages</th></tr></thead>
    <tbody>{filtered.slice((page - 1) * 50, page * 50).map(i => <tr>
      <th scope="row"><a href={`/isp/${i.slug}`}>{i.name}</a>{i.possiblyLapsed && <small class="muted"> · Possibly lapsed</small>}</th>
      <td>{i.licence}</td><td>{i.nationwide ? 'Nationwide licence' : i.districts.length ? i.districts.map(s => DISTRICTS.find(d => d.slug === s)?.name).join(', ') : 'Location not confirmed'}</td>
      <td>{PACKAGES[i.name]?.packages.length ? `${PACKAGES[i.name].packages.length} published packages` : 'No published packages'}</td>
    </tr>)}</tbody>
  </table></div> : <p>No providers match. Try another name or district.</p>}
  <nav class="row-between" aria-label="Directory pages" style="margin-top:20px">
    {page > 1 ? <a class="btn" href={pageUrl(page - 1)}>Previous</a> : <span />}
    {page < pages && <a class="btn" href={pageUrl(page + 1)}>Next</a>}
  </nav>
  {!district && <details style="margin-top:24px"><summary>Browse all 64 districts</summary><nav class="chips" aria-label="Districts">{DISTRICTS.map(d => <a href={`/district/${d.slug}`}>{d.name}</a>)}</nav></details>}
</section>
<style>
.directory-filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); align-items:end; gap:14px; margin-top:24px; }
.directory-filters button { min-height:48px; }
table { min-width:680px; }
td, th { overflow-wrap:break-word; }
</style>
